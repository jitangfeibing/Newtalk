NEWTALK_HOST=127.0.0.1
NEWTALK_PORT=8006
NEWTALK_LOG_LEVEL=INFO
# NEWTALK_WEB_ROOT=D:\Desktop\Newtalk\web

# P3 defaults to Fake LLM so local tests and CI never require a secret.
NEWTALK_LLM_BACKEND=fake
# To use an OpenAI-compatible provider, set all required values in local .env:
# NEWTALK_LLM_BACKEND=openai
# NEWTALK_LLM_API_KEY=replace-with-local-secret
# NEWTALK_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# NEWTALK_LLM_MODEL=glm-4-flash
# NEWTALK_LLM_SYSTEM_PROMPT=你是 Newtalk，一个简洁、友善的家庭陪伴助手。
# NEWTALK_LLM_TIMEOUT_SECONDS=30

# P4 defaults to deterministic Fake TTS for local tests and CI.
NEWTALK_TTS_BACKEND=fake
# To use Doubao V3 bidirectional streaming TTS, set these in local .env:
# NEWTALK_TTS_BACKEND=doubao
# NEWTALK_TTS_APP_ID=replace-with-local-app-id
# NEWTALK_TTS_ACCESS_TOKEN=replace-with-local-secret
# NEWTALK_TTS_RESOURCE_ID=seed-tts-2.0
# NEWTALK_TTS_VOICE_TYPE=replace-with-enabled-voice
# NEWTALK_TTS_AUDIO_FORMAT=pcm
# NEWTALK_TTS_SAMPLE_RATE=24000
# NEWTALK_TTS_TIMEOUT_SECONDS=30
# Keep false unless Doubao must use the operating system proxy.
# NEWTALK_TTS_USE_SYSTEM_PROXY=false

# P5 local voice activity detection. The bundled model is Silero VAD v6.2.1.
# NEWTALK_VAD_MODEL_PATH=D:\Desktop\Newtalk\models\silero_vad.onnx
NEWTALK_VAD_THRESHOLD=0.5
NEWTALK_VAD_THRESHOLD_LOW=0.3
NEWTALK_VAD_MIN_SILENCE_MS=600
NEWTALK_VAD_PRE_ROLL_MS=300

# P5 keeps deterministic Fake ASR for local tests and CI.
NEWTALK_ASR_BACKEND=fake
NEWTALK_ASR_FAKE_TEXT=这是一次语音输入测试
# To use Doubao 2.0 bidirectional streaming ASR, set these in local .env:
# NEWTALK_ASR_BACKEND=doubao
# NEWTALK_ASR_API_KEY=replace-with-local-secret
# Hourly resource: volc.seedasr.sauc.duration
# Concurrent resource: volc.seedasr.sauc.concurrent
# NEWTALK_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# NEWTALK_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
# NEWTALK_ASR_PACKET_DURATION_MS=100
# NEWTALK_ASR_TIMEOUT_SECONDS=30
# Keep false unless Doubao must use the operating system proxy.
# NEWTALK_ASR_USE_SYSTEM_PROXY=false
